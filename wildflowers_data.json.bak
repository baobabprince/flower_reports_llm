  {
    "date": "10/12/2009",
    "observer": "המטייל האנונימי",
    "title": "נרקיס מצוי",
    "description": [
      "נכנסים לחניון פיתולים  ליד חוות הרוכבים בכניסה לבית אורן. לאחר כמה עשרות מטרים פנייה שמאלה לדרך עם שער בקר (ניתן להיכנס). מיד אחכ - בשני הצדדים ומעט בעומק - פריחה של עשרות נרקיסים"
    ],
    "locations": [
      "חניון הפיתולים, חוות הרוכבים, בית אורן"
    ],
    "flowers": [
      "נרקיס מצוי"
    ],
    "coordinates": [
      null
    ],
    "source_file": "tiuli_scraped_reports/page_156_report_1_class.html"
  },
  {
    "date": "10/12/2009",
