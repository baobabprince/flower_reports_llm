  {
    "date": "29/11/2014",
    "observer": "עומר זיו מערכת טיולי",
    "title": "רקפת מצויה",
    "description": [
      "מחניון האגם במעלה נחל רקית לעבר הר שוקף. פריחה לאורך כל הדרך."
    ],
    "locations": [
      "נחל רקית והר שוקף"
    ],
    "flowers": [
      "רקפת מצויה"
    ],
