        "lon": 35.1436576
      }
    ],
    "source_file": "tiuli_scraped_reports/page_181_report_1_class.html"
  },
  {
    "date": "22/04/2007",
    "observer": "המטייל האנונימי",
    "title": "לוע-ארי גדול",
    "description": [
      "כפי שדווח לפני כמות גדולה מאד של לוע-הארי הגדול. נכון שבתחילתהקטע אין אפשרות לחנות או לעצור כי אין שויים, אך בהמשך ליד הכניסה לאנדרטת פורצי הדרך לירושלים ובכניסה ליער נוה אילן ניתן לחנות ועם קצת כיתות רגליים ניתן למצוא הרבה קבוצות יפייפיות של  הפרח.…קרא עודמי שיסתובב קצת יותר יכול למצוא גם ירוקת החמור (פורח) סייפן התבואה, לוטם מרווני, לוטם שעיר ועוד"
    ],
    "locations": [
      "בין הכניסה המזרחית לאבו גוש ועשצומת הכניסה לשורש"
    ],
    "flowers": [
      "לוע-ארי גדול"
    ],
    "coordinates": [
      null
    ],
    "source_file": "tiuli_scraped_reports/page_181_report_1_class.html"
  },
